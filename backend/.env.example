# AllFence Backend Environment Variables
# Copy this to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Read-only mode: rejects every POST/PUT/DELETE request before it reaches the
# database. Defaults to true, which is what the public Vercel deployment runs
# with (see README.md > Deployment). Set to false for local read/write dev.
DEMO_MODE=false

# Database Configuration
# For local development, leave commented to use the bundled SQLite database
# For an external PostgreSQL database (Neon/Supabase/etc), set the connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# CORS Configuration
# Only relevant if you split the frontend and backend across different origins
# (the default Vercel deployment serves both from one domain, so this is unused there)
CORS_ORIGINS=*

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here

# Server Configuration
HOST=0.0.0.0
PORT=5001
